// ============================================================
// Listing Details: Houses (Phase 2)
// ============================================================

model ListingHouse {
  listingId  Int        @id @map("listing_id")
  houseType  HouseType? @map("house_type")
  material   String?    @db.VarChar(64)
  areaTotal  Decimal?   @map("area_total") @db.Decimal(10, 2)
  areaLiving Decimal?   @map("area_living") @db.Decimal(10, 2)
  areaKitchen Decimal?  @map("area_kitchen") @db.Decimal(10, 2)
  areaLand   Decimal?   @map("area_land") @db.Decimal(10, 2)
  floorsCount Int?      @map("floors_count")
  bedrooms   Int?
  bathrooms  Int?
  districtName String?  @map("district_name") @db.VarChar(128)
  settlement String?    @db.VarChar(128)
  street     String?    @db.VarChar(255)
  houseNumber String?   @map("house_number") @db.VarChar(64)
  synonyms   String?    @db.VarChar(512)
  distanceToCity Int?   @map("distance_to_city")
  directionSouth Boolean @default(false) @map("direction_south")
  directionNorth Boolean @default(false) @map("direction_north")
  directionEast  Boolean @default(false) @map("direction_east")
  directionWest  Boolean @default(false) @map("direction_west")
  inBelgorodDistrict Boolean @default(true) @map("in_belgorod_district")
  inBelgorodRegion Boolean @default(true) @map("in_belgorod_region")
  hasGarage  Boolean?   @map("has_garage")
  yearBuilt  Int?       @map("year_built")
  photoUrl   String?    @map("photo_url")
  extraPhotoUrls Json?  @map("extra_photo_urls")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_houses")
}

// ============================================================
// Field Overrides
// ============================================================

model FieldOverride {
  id           Int       @id @default(autoincrement())
  entityType   String    @map("entity_type")
  entityId     Int       @map("entity_id")
  fieldName    String    @map("field_name")
  valueText    String?   @map("value_text") @db.Text
  valueNumber  Decimal?  @map("value_number")
  valueBoolean Boolean?  @map("value_boolean")
  overriddenBy String?   @map("overridden_by") @db.Uuid
  overriddenAt DateTime? @map("overridden_at")

  user User? @relation(fields: [overriddenBy], references: [id])

  @@unique([entityType, entityId, fieldName])
  @@map("field_overrides")
}

// ============================================================
// Media
// ============================================================

model MediaFolder {
  id        Int      @id @default(autoincrement())
  parentId  Int?     @map("parent_id")
  name      String   @db.VarChar(255)
  isTrash   Boolean  @default(false) @map("is_trash")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent            MediaFolder?  @relation("MediaFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children          MediaFolder[] @relation("MediaFolderChildren")
  files             MediaFile[]   @relation("MediaFileFolder")
  previousForFiles  MediaFile[]   @relation("MediaFilePreviousFolder")

  @@unique([parentId, name])
  @@map("media_folders")
}

model MediaFile {
  id                 Int       @id @default(autoincrement())
  entityType         String?   @map("entity_type")
  entityId           Int?      @map("entity_id")
  kind               MediaKind
  url                String
  originalFilename   String?   @map("original_filename")
  sizeBytes          BigInt?   @map("size_bytes")
  sortOrder          Int       @default(0) @map("sort_order")
  uploadedBy         String?   @map("uploaded_by") @db.Uuid
  folderId           Int?      @map("folder_id")
  previousFolderId   Int?      @map("previous_folder_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user             User?        @relation(fields: [uploadedBy], references: [id])
  folder           MediaFolder? @relation("MediaFileFolder", fields: [folderId], references: [id], onDelete: SetNull)
  previousFolder   MediaFolder? @relation("MediaFilePreviousFolder", fields: [previousFolderId], references: [id], onDelete: SetNull)

  @@index([folderId])
  @@map("media_files")
}

// ============================================================
// Import Batches
// ============================================================

model ImportBatch {
  id             Int               @id @default(autoincrement())
  regionId       Int               @map("region_id")
  status         ImportBatchStatus @default(PENDING)
  feedExportedAt DateTime?         @map("feed_exported_at")
  startedAt      DateTime?         @map("started_at")
  finishedAt     DateTime?         @map("finished_at")
  stats          Json?
  errorMessage   String?           @map("error_message") @db.Text
  triggeredBy    String?           @map("triggered_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")

  region FeedRegion @relation(fields: [regionId], references: [id])
  user   User?      @relation("TriggeredImports", fields: [triggeredBy], references: [id])

  @@map("import_batches")
}

// ============================================================
// Requests (CRM)
// ============================================================

model Request {
  id           Int           @id @default(autoincrement())
  name         String?
  phone        String?
  email        String?
  type         RequestType   @default(CONSULTATION)
  status       RequestStatus @default(NEW)
  blockId      Int?          @map("block_id")
  listingId    Int?          @map("listing_id")
  sourceUrl    String?       @map("source_url")
  userId       String?       @map("user_id") @db.Uuid
  assignedTo   String?       @map("assigned_to") @db.Uuid
  comment      String?       @db.Text
  telegramSent Boolean       @default(false) @map("telegram_sent")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  lastActivityAt DateTime    @default(now()) @map("last_activity_at")

  user         User? @relation("SubmittedRequests", fields: [userId], references: [id], onDelete: SetNull)
  assignedUser User? @relation("AssignedRequests", fields: [assignedTo], references: [id])
  events       RequestEvent[]
  notifications CrmNotification[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([assignedTo, status])
  @@index([lastActivityAt])
  @@map("requests")
}

model RequestEvent {
  id        Int              @id @default(autoincrement())
  requestId Int              @map("request_id")
  type      RequestEventType
  fromStatus RequestStatus?  @map("from_status")
  toStatus   RequestStatus?  @map("to_status")
  note      String?          @db.Text
  actorId   String?          @map("actor_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?   @relation("RequestEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  notifications CrmNotification[]

  @@index([requestId, createdAt])
  @@map("request_events")
}

model CrmNotification {
  id            Int                     @id @default(autoincrement())
  type          CrmNotificationType
  priority      CrmNotificationPriority @default(NORMAL)
  recipientId   String                  @map("recipient_id") @db.Uuid
  requestId     Int?                    @map("request_id")
  actorId       String?                 @map("actor_id") @db.Uuid
  sourceEventId Int?                    @map("source_event_id")
  dedupeKey     String                  @map("dedupe_key") @db.VarChar(320)
  title         String
  body          String?                 @db.Text
  readAt        DateTime?               @map("read_at")
  createdAt     DateTime                @default(now()) @map("created_at")

  recipient   User          @relation("CrmNotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?         @relation("CrmNotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  request     Request?      @relation(fields: [requestId], references: [id], onDelete: SetNull)
  sourceEvent RequestEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, readAt, createdAt])
  @@index([requestId])
  @@map("crm_notifications")
}

model CrmAnalyticsSnapshot {
  id           Int              @id @default(autoincrement())
  snapshotDate DateTime         @map("snapshot_date") @db.Date
  kind         CrmSnapshotKind
  payload      Json
  computeMs    Int?             @map("compute_ms")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@unique([snapshotDate, kind])
  @@index([kind, snapshotDate])
  @@map("crm_analytics_snapshots")
}

model TelegramNotifyAccessRequest {
  id               Int                        @id @default(autoincrement())
  telegramUserId   BigInt                     @map("telegram_user_id")
  telegramChatId   BigInt                     @map("telegram_chat_id")
  telegramUsername String?                    @map("telegram_username")
  telegramFirstName String?                   @map("telegram_first_name")
  telegramLastName String?                    @map("telegram_last_name")
  status           TelegramNotifyAccessStatus @default(PENDING)
  reviewedBy       String?                    @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?                  @map("reviewed_at")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  reviewer User? @relation("ReviewedTelegramRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([telegramUserId, status])
  @@map("telegram_notify_access_requests")
}

model TelegramNotifyRecipient {
  id               Int       @id @default(autoincrement())
  telegramUserId   BigInt    @unique @map("telegram_user_id")
  telegramChatId   BigInt    @map("telegram_chat_id")
  telegramUsername String?   @map("telegram_username")
  telegramFirstName String?  @map("telegram_first_name")
  telegramLastName String?   @map("telegram_last_name")
  isActive         Boolean   @default(true) @map("is_active")
  approvedBy       String?   @map("approved_by") @db.Uuid
  approvedAt       DateTime? @map("approved_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  approver User? @relation("ApprovedTelegramRecipients", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([isActive, createdAt])
  @@map("telegram_notify_recipients")
}

// ============================================================
// Favorites
// ============================================================

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  blockId   Int?     @map("block_id")
  listingId Int?     @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  block   Block?   @relation(fields: [blockId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, blockId, listingId])
  @@index([userId])
  @@map("favorites")
}

// ============================================================
// User collections (подборки)
// ============================================================

model UserCollection {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  shareToken String? @unique @map("share_token")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items UserCollectionItem[]

  @@index([userId])
  @@map("user_collections")
}

model UserCollectionItem {
  id           String               @id @default(uuid()) @db.Uuid
  collectionId String               @map("collection_id") @db.Uuid
  kind         CollectionItemKind
  entityId     Int                  @map("entity_id")
  createdAt    DateTime             @default(now()) @map("created_at")

  collection UserCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, kind, entityId])
  @@index([collectionId])
  @@map("user_collection_items")
}

// ============================================================
// News
// ============================================================

model News {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  regionId    Int?     @map("region_id")
  title       String
  body        String?  @db.Text
  imageUrl    String?  @map("image_url")
  source      String?
  sourceUrl   String?  @map("source_url")
  publishedAt DateTime? @map("published_at")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  region      FeedRegion? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([regionId])
  @@map("news")
}

/// Каналы Telegram для импорта новостей (MTProto). Секреты — только в env сервера.
model NewsTelegramChannel {
  id               Int      @id @default(autoincrement())
  regionId         Int      @map("region_id")
  channelRef       String   @map("channel_ref") @db.VarChar(255)
  label            String?  @db.VarChar(255)
  isEnabled        Boolean  @default(true) @map("is_enabled")
  limitPerRun      Int      @default(20) @map("limit_per_run")
  publishOnImport  Boolean  @default(true) @map("publish_on_import")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  region           FeedRegion @relation(fields: [regionId], references: [id], onDelete: Restrict)

  @@unique([regionId, channelRef])
  @@index([regionId])
  @@map("news_telegram_channels")
}

// ============================================================
// CMS: Site Settings
// ============================================================

model SiteSetting {
  id        Int                  @id @default(autoincrement())
  key       String               @unique
  value     String               @db.Text
  groupName String               @map("group_name")
  label     String
  fieldType SiteSettingFieldType @map("field_type")
  sortOrder Int                  @default(0) @map("sort_order")
  updatedBy String?              @map("updated_by") @db.Uuid
  updatedAt DateTime             @updatedAt @map("updated_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user User? @relation("UpdatedSettings", fields: [updatedBy], references: [id])

  @@index([groupName])
  @@map("site_settings")
}

// ============================================================
// CMS: Content Blocks
// ============================================================

model ContentBlock {
  id        Int      @id @default(autoincrement())
  pageSlug  String   @map("page_slug")
  blockType String   @map("block_type")
  sortOrder Int      @default(0) @map("sort_order")
  isVisible Boolean  @default(true) @map("is_visible")
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User?              @relation("UpdatedBlocks", fields: [updatedBy], references: [id])
  fields ContentBlockField[]
  items  ContentBlockItem[]

  @@unique([pageSlug, blockType])
  @@index([pageSlug])
  @@map("content_blocks")
}

model ContentBlockField {
  id           Int              @id @default(autoincrement())
  blockId      Int              @map("block_id")
  fieldKey     String           @map("field_key")
  fieldType    ContentFieldType @map("field_type")
  valueText    String?          @map("value_text") @db.Text
  valueNumber  Decimal?         @map("value_number")
  valueBoolean Boolean?         @map("value_boolean")
  sortOrder    Int              @default(0) @map("sort_order")
  label        String
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  block ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, fieldKey])
  @@index([blockId])
  @@map("content_block_fields")
}

model ContentBlockItem {
  id            Int      @id @default(autoincrement())
  blockId       Int      @map("block_id")
  collectionKey String   @map("collection_key")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  block  ContentBlock           @relation(fields: [blockId], references: [id], onDelete: Cascade)
  fields ContentBlockItemField[]

  @@index([blockId])
  @@map("content_block_items")
}

model ContentBlockItemField {
  id           Int                  @id @default(autoincrement())
  itemId       Int                  @map("item_id")
  fieldKey     String               @map("field_key")
  fieldType    ContentItemFieldType @map("field_type")
  valueText    String?              @map("value_text") @db.Text
  valueNumber  Decimal?             @map("value_number")
  valueBoolean Boolean?             @map("value_boolean")
  label        String

  item ContentBlockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, fieldKey])
  @@map("content_block_item_fields")
}

// ============================================================
// CMS: Navigation
// ============================================================

model NavigationMenu {
  id        Int      @id @default(autoincrement())
  location  String   @unique
  label     String
  updatedAt DateTime @updatedAt @map("updated_at")

  items NavigationItem[]

  @@map("navigation_menus")
}

model NavigationItem {
  id         Int      @id @default(autoincrement())
  menuId     Int      @map("menu_id")
  parentId   Int?     @map("parent_id")
  title      String
  url        String
  icon       String?
  isExternal Boolean  @default(false) @map("is_external")
  isVisible  Boolean  @default(true) @map("is_visible")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  menu     NavigationMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   NavigationItem? @relation("NavItemHierarchy", fields: [parentId], references: [id])
  children NavigationItem[] @relation("NavItemHierarchy")

  @@index([menuId])
  @@index([parentId])
  @@map("navigation_items")
}

// ============================================================
// CMS: Mortgage Banks
// ============================================================

model MortgageBank {
  id        Int      @id @default(autoincrement())
  name      String
  rateFrom  Decimal? @map("rate_from") @db.Decimal(5, 2)
  rateTo    Decimal? @map("rate_to") @db.Decimal(5, 2)
  logoUrl   String?  @map("logo_url")
  url       String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mortgage_banks")
}

// ============================================================
// Audit
// ============================================================

model AuditEvent {
  id         BigInt      @id @default(autoincrement())
  userId     String?     @map("user_id") @db.Uuid
  entityType String      @map("entity_type")
  entityId   Int         @map("entity_id")
  action     AuditAction
  oldData    Json?       @map("old_data")
  newData    Json?       @map("new_data")
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_events")
}
