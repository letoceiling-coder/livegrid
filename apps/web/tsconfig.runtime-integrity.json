{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/shared/hooks/useAuth.ts",
    "src/shared/hooks/index.ts",
    "src/shared/lib/lazy-route.ts",
    "src/shared/lib/route-registry.ts",
    "src/shared/lib/runtime-integrity-entry.ts"
  ]
}
